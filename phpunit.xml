<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="false"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true"
         displayDetailsOnTestsThatTriggerWarnings="true">

    <testsuites>
        <testsuite name="Unit Tests">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>

    <!--
        Where coverage is measured from when it is asked for. There is
        deliberately no <coverage><report> block: declaring report outputs
        makes PHPUnit collect coverage on every run, which warns "No code
        coverage driver available" and returns a non-zero exit code on any
        machine without Xdebug or pcov - including CI, which sets
        coverage: none. The composer test:coverage script passes the
        coverage flags when coverage is actually wanted.
    -->
    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
        <exclude>
            <directory>src/Config</directory>
            <file>src/autoload.php</file>
            <!--
                src/Admin is deliberately NOT excluded. It used to be, as
                "WordPress render/callback and menu glue exercised through the
                admin UI at runtime" — the same exclusion the other suite
                plugins apply to their src/Admin layers. Amber covers its whole
                src/Admin on this same tooling, which showed the exclusion was
                habit rather than necessity, and it was hiding real logic:
                answer aggregation, duplicate detection, coverage arithmetic
                and email templating all live under src/Admin here.

                It is covered by tests/Unit/Admin. Do not reintroduce the
                exclusion — see those tests' class docblocks for the three
                techniques that make the layer testable (drive registration
                against WpState, assert on wp_die()/wp_send_json_* throwing,
                and capture renders with ob_start()).
            -->
        </exclude>
    </source>

    <php>
        <ini name="display_errors" value="1"/>
        <ini name="error_reporting" value="-1"/>
        <ini name="memory_limit" value="512M"/>
        <!-- WordPress Test Environment Variables -->
        <const name="WP_TESTS_DOMAIN" value="example.org"/>
        <const name="WP_TESTS_EMAIL" value="admin@example.org"/>
        <const name="WP_TESTS_TITLE" value="Test Blog"/>
        <const name="WP_DEBUG" value="true"/>
    </php>
</phpunit>
